{
	"name": "Zephyr",
	"build": {
		"dockerfile": "Dockerfile",
    "context": ".."
	},
	"remoteUser": "user",
	"onCreateCommand": "bash -c 'west update'",
	"postStartCommand": "bash",
	"customizations": {
		"vscodeu": {
			"extensions": [
				"twxs.cmake",
				"llvm-vs-code-extensions.vscode-clangd",
				"nordic-semiconductor.nrf-kconfig",
				"nordic-semiconductor.nrf-terminal",
				"nordic-semiconductor.nrf-devicetree"
			],
      "settings": {
          "terminal.integrated.defaultProfile.linux": "bash",
          "terminal.integrated.profiles.linux": { "bash": { "path": "/bin/bash" } }
      }
		}
	},
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/user/west-workspace/timelord-firmware,type=bind", 
  "workspaceFolder": "/home/user/west-workspace/timelord-firmware",
  "runArgs": ["--privileged", "-v", "/dev:/dev"],
	"features": {
	    "ghcr.io/devcontainers/features/nix:1": {
	    	"packages": ["helix"],
	    	
	    }
	}
}    
